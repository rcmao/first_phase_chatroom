# TKI智能干预聊天机器人Web应用环境变量

# Flask配置
SECRET_KEY=your-secret-key-here-change-this-in-production
FLASK_ENV=development
FLASK_DEBUG=True

# 数据库配置
DATABASE_URL=sqlite:///chatbot.db

# OpenAI配置（如果需要）
OPENAI_API_KEY=sk-XGGe5y0ZvLcQVFp6XnRizs7q47gsVnAbZx0Xr2mfcVlbr99f
OPENAI_BASE_URL=https://api2.aigcbest.top/v1

# LLM干预功能配置
LLM_TOXICITY_ENABLED=true
LLM_INTERVENTION_ENABLED=true
LLM_TOXICITY_MODEL=gpt-4o-mini
LLM_MESSAGE_MODEL=gpt-4o-mini
LLM_TIMEOUT_SEC=10.0

# 冲突检测配置（已优化减少误判）
LLM_CONFLICT_THRESHOLD=0.8          # 冲突检测阈值（0.6 → 0.8 减少误判）
CONFLICT_DETECTION_STRATEGY=llm_primary  # 使用LLM优先策略
LLM_CONFLICT_FALLBACK=true         # 启用关键词检测作为备选

LLM_CONFIDENCE=0.3
GLOBAL_COOLDOWN=30

# 群体沉默检测配置
AGENDA_TRANSITION_THRESHOLD=60  # 群体沉默触发时间（秒）
AGENDA_TRANSITION_COOLDOWN=120  # 群体沉默干预冷却时间（秒）
SILENCE_THRESHOLD=90            # 个人沉默检测时间（秒）

FOOTBALL_ON_TOPIC_RATIO=0.3

# 新版检测系统配置
DETECTION_MODE=hybrid  # 'toxicity', 'conflict', 'hybrid'
CONFLICT_DETECTION_MODE=hybrid  # 保持向后兼容

# 毒性检测配置
TOXICITY_ZERO_TOLERANCE=true  # 零容忍模式
TOXICITY_IMMEDIATE_SEVERE=true  # 严重毒性立即干预

# 冲突检测配置
CONFLICT_MODE=proactive  # 'proactive', 'reactive', 'disabled'
CONFLICT_ESCALATION_THRESHOLD=3  # 升级检测阈值

# LLM增强配置
LLM_ENABLED=true
LLM_CONFIDENCE_THRESHOLD=0.7  # LLM毒性检测置信度阈值
LLM_CONFLICT_THRESHOLD=0.85  # LLM冲突检测置信度阈值（减少误报）
LLM_MODEL=gpt-4o-mini

# 冲突检测策略配置（新增）
CONFLICT_DETECTION_STRATEGY=llm_primary  # 'llm_primary', 'keyword_primary', 'hybrid'
LLM_CONFLICT_FALLBACK=true  # LLM失败时是否回退到关键词检测

# 其他配置
HOST=0.0.0.0
PORT=8080